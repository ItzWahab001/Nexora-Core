# ============================================
# Discord Bot Configuration
# ============================================

# Required: Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Optional: Restrict slash command sync to a single guild for instant updates during development.
# Leave empty to sync globally (can take up to 1 hour to propagate).
DEV_GUILD_ID=

# Comma-separated list of Discord user IDs who have bot-owner access (bypasses guild admin checks
# for bot-level commands like /admin reload, shutdown, etc.)
OWNER_IDS=

# ============================================
# AI Chat Configuration
# ============================================
# The AI provider abstraction (services/ai_service.py) currently ships with an
# OpenAI-compatible implementation. Point BASE_URL at any OpenAI-compatible
# endpoint (OpenAI, Azure OpenAI, local LLM server, etc).
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Optional: absolute path to ffmpeg if it is not on PATH.
FFMPEG_PATH=

# ============================================
# Database
# ============================================
DATABASE_PATH=data/bot.db

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
