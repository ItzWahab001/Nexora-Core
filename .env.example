# ── Core ─────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token_here
DEFAULT_PREFIX=!
DATABASE_PATH=data/bot.db

# ── TTS (Voice Onboarding) ──────────────────────────
# Provider options: edge (free, no key needed), elevenlabs, openai
TTS_PROVIDER=edge
TTS_API_KEY=
TTS_VOICE=en-US-GuyNeural

# ── AI Chat (optional) ───────────────────────────────
# Gemini is used automatically when GEMINI_API_KEY is set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional Anthropic fallback if Gemini is not configured:
AI_API_KEY=
AI_BASE_URL=https://api.anthropic.com
AI_MODEL=claude-sonnet-4-5

# ── Music (optional) ─────────────────────────────────
# No YouTube Data API key is required for yt-dlp based playback.

# ── Logging ──────────────────────────────────────────
LOG_LEVEL=INFO
# Optional: set your test server ID for immediate slash-command sync.
# SYNC_GUILD_ID=123456789012345678
