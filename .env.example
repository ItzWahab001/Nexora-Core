# ── Core ─────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token_here
DEFAULT_PREFIX=!
DATABASE_PATH=data/bot.db

# ── TTS (Voice Onboarding) ──────────────────────────
# Provider options: edge (free, no key needed), elevenlabs, openai
TTS_PROVIDER=edge
TTS_API_KEY=
TTS_VOICE=en-US-GuyNeural

# ── AI Chat (optional) ───────────────────────────────
AI_API_KEY=
AI_BASE_URL=https://api.anthropic.com
AI_MODEL=claude-sonnet-4-5

# ── Music (optional) ─────────────────────────────────
# No key required for yt-dlp based playback

# ── Logging ──────────────────────────────────────────
LOG_LEVEL=INFO
